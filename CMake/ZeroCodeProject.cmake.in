# Generated stub for a project that has no CMakeLists.txt of its own.
#
# Written by Projects/CMakeLists.txt into <Project>/Intermediate/Generated so that add_subdirectory can
# give the project a binary directory inside itself. PROJECT_DIR points back at the authored directory,
# since CMAKE_CURRENT_SOURCE_DIR here is the generated location.
#
# Do not edit: regenerated on every configure. Adding a real CMakeLists.txt to the project takes
# precedence over this file.

lime_add_project(PROJECT_DIR "@ProjectDir@")
