diff --git a/imgui_extra_math.h b/imgui_extra_math.h
index 3df615a..86661d0 100644
--- a/imgui_extra_math.h
+++ b/imgui_extra_math.h
@@ -34,7 +34,13 @@ struct ImLine
 inline bool operator==(const ImVec2& lhs, const ImVec2& rhs);
 inline bool operator!=(const ImVec2& lhs, const ImVec2& rhs);
 # endif
+// LOCAL PATCH: guarded for 19268, where Dear ImGui added this operator itself (commit 3c78afbbb,
+// "Added missing ImVec2/ImVec4 operators"). Upstream declares it unconditionally, which redefines
+// ImGui's own and fails to compile on 1.92. The surrounding declarations are already version gated
+// the same way; this one was simply missed.
+# if IMGUI_VERSION_NUM < 19268
 inline ImVec2 operator*(const float lhs, const ImVec2& rhs);
+# endif
 # if IMGUI_VERSION_NUM < 18955
 inline ImVec2 operator-(const ImVec2& lhs);
 # endif
diff --git a/imgui_extra_math.inl b/imgui_extra_math.inl
index 8e2347f..56d5ee1 100644
--- a/imgui_extra_math.inl
+++ b/imgui_extra_math.inl
@@ -31,10 +31,13 @@ inline bool operator!=(const ImVec2& lhs, const ImVec2& rhs)
 }
 # endif
 
+// LOCAL PATCH: see imgui_extra_math.h. Dear ImGui defines this itself from 19268 on.
+# if IMGUI_VERSION_NUM < 19268
 inline ImVec2 operator*(const float lhs, const ImVec2& rhs)
 {
     return ImVec2(lhs * rhs.x, lhs * rhs.y);
 }
+# endif
 
 # if IMGUI_VERSION_NUM < 18955
 inline ImVec2 operator-(const ImVec2& lhs)
