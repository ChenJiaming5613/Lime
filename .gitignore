# Build outputs
/Build/
/build/
/out/
[Bb]in/
[Oo]bj/

# Per project build outputs. Each project keeps its binaries and intermediates next to its sources,
# so these live inside a tracked tree and have to be excluded by name.
/Projects/*/Binaries/
/Projects/*/Intermediate/

# Visual Studio / VS Code / JetBrains
.vs/
.idea/
*.user
*.suo
*.sln
*.vcxproj*
CMakeUserPresets.json

# Editor configuration: the shared files reference only ${workspaceFolder} and repository scripts, so
# they work on any machine. settings.json is excluded because it pins local tool paths (CMake, clangd,
# the Vulkan SDK), and .clangd because Scripts/UpdateClangdConfig.ps1 generates it from the installed
# MSVC and Windows SDK.
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
/.clangd

# CMake
CMakeCache.txt
CMakeFiles/
compile_commands.json

# clangd background index. Machine-local and large, but .clangd itself is configuration and is tracked.
/.cache/

# Downloaded tool binaries
/ThirdParty/Binaries/

# Runtime artifacts
imgui.ini
*.log
/Logs/
# Written next to the executable, which lives under an ignored per project Binaries directory; listed
# so a relocated output directory does not start tracking them either.
Saved/
AutomationEndpoint.json

# Python automation
__pycache__/
*.pyc
.pytest_cache/
# Local virtual environments for the automation suite.
.venv/
venv/

# Shared sample assets. Fetched on demand by Scripts/FetchSampleAssets.ps1 and far too large to
# version: the Khronos glTF sample set alone is several gigabytes.
/Assets/

.codebuddy/